namespace app\demo;

import "std";
import foo, bar from "mod" as app\mod;

object Payload::<T> {
    data: [T],

    static fun init(data: [T]) > Payload::<T> {
        return Payload::<T>{ data = data };
    }
}

protocol Nameable {
    mut fun rename(name: str) > void;
}

enum<str> Direction {
    north,
    south,
}

fun count::<T>(list: [T]) > int {
    return list.len();
}

test "sample" {
    final payload = Payload::<int>{ data = [1, 2, 3] };
    var total = 0;

    foreach (index, value in payload.data): values {
        total += index + value;
    }

    _ = total ?? 0;
    _ = Direction.north.value as? str;
}

