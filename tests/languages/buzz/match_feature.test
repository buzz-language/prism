match (value) {
    1, 2 -> "selected",
    3..5 -> "range",
    $"hello [a-z]+" -> "pattern",
    <MatchBox> -> "type",
    else -> "other",
}

final result = match (value) {
    MatchEnum.one -> "one",
    MatchEnum.two -> "two"
};

